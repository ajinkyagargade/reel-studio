# Copy to .env and edit.
# Optional but recommended: Claude writes much better summaries, chapters and narration.
# Without it the app uses a free local fallback for analysis (the AI explainer needs the key).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Whisper model: tiny | base | small | medium | large-v3  (bigger = more accurate, slower)
WHISPER_MODEL=small
# WHISPER_DEVICE=auto        # auto | cpu | cuda
# WHISPER_COMPUTE=int8       # int8 on CPU, float16 on GPU

# MAX_UPLOAD_GB=8
# CORS_ORIGINS=http://localhost:3000   # when the frontend is hosted elsewhere (e.g. Vercel), put its URL here
